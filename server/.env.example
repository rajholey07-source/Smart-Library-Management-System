# Smart Library API — environment configuration
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=7d
DB_FILE=./data/library.db

# Library rules (defaults; also editable at runtime from Admin → Settings)
BORROW_DAYS=14
MAX_BOOKS_PER_STUDENT=5
FINE_PER_DAY=5
SEED_ON_START=true
